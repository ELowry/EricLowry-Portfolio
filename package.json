{
	"type": "module",
	"dependencies": {
		"littlejsengine": "^1.18.0",
		"marked": "^17.0.4",
		"marked-alert": "^2.1.2",
		"marked-gfm-heading-id": "^4.1.3",
		"marked-responsive-images": "*"
	},
	"scripts": {
		"generate-sitemaps": "node scripts/generateSitemaps.mjs",
		"copy-deps": "powershell -ExecutionPolicy Bypass -File scripts/copy-deps.ps1",
		"copy-deps:prod": "powershell -ExecutionPolicy Bypass -File scripts/copy-deps.ps1 -Prod",
		"dev": "npm run generate-sitemaps && npm run copy-deps && vite",
		"build": "npm run generate-sitemaps && npm run copy-deps:prod && vite build",
		"deploy": "npm run build && firebase deploy"
	},
	"devDependencies": {
		"lightningcss": "^1.31.1",
		"prettier": "^3.8.1",
		"prettier-plugin-css-order": "^2.2.0",
		"vite": "^7.3.1"
	}
}
